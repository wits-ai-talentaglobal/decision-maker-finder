# Copy this file to .env and fill in real values. Never commit .env.

# --- Stage 1: company identity + LinkedIn resolution (OpenRouter / Perplexity Sonar) ---
OPENROUTER_API_KEY=

# --- Stage 2: employee scrape (Apify) ---
APIFY_API_TOKEN=
APIFY_EMPLOYEES_ACTOR_ID=harvestapi/linkedin-company-employees

# --- Stages 3-4: decision-maker extraction + validation (Claude API, direct) ---
ANTHROPIC_API_KEY=

# --- Stage 5: contact enrichment (Apollo.io) ---
APOLLO_API_KEY=

# --- Stage 6: email fallback (Hunter.io) ---
HUNTER_API_KEY=

# --- Database ---
# SQLite for local/dev (default). Swap to a Postgres URL for deployment, e.g.
# postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./decision_maker_finder.db

# --- Backend server ---
BACKEND_CORS_ORIGINS=http://localhost:5173
JOB_CONCURRENCY_LIMIT=5
BATCH_CONFIRMATION_THRESHOLD=10
